--- a/drivers/interconnect/core.c
+++ b/drivers/interconnect/core.c
@@ -10,6 +10,7 @@
 #include <linux/device.h>
 #include <linux/idr.h>
 #include <linux/init.h>
+#include <linux/kstrtox.h>
 #include <linux/interconnect.h>
 #include <linux/interconnect-provider.h>
 #include <linux/list.h>
@@ -24,6 +25,17 @@
 
 #define CREATE_TRACE_POINTS
 #include "trace.h"
+
+/* Diagnostic-only, active only while the final ICC sync holds its locks. */
+static bool v30_icc_trace;
+bool v30_icc_sync_trace_active;
+EXPORT_SYMBOL_GPL(v30_icc_sync_trace_active);
+
+static int __init v30_icc_trace_setup(char *arg)
+{
+	return kstrtobool(arg, &v30_icc_trace);
+}
+early_param("v30.icc_trace", v30_icc_trace_setup);
 
 static DEFINE_IDR(icc_idr);
 static LIST_HEAD(icc_providers);
@@ -1219,26 +1231,40 @@
 	struct icc_provider *p;
 	struct icc_node *n;
 	static int count;
+	int ret;
 
 	count++;
+	if (v30_icc_trace)
+		dev_notice(dev, "V30-R17 ICC provider sync count=%d total=%d\n", count, providers_count);
 
 	if (count < providers_count)
 		return;
 
 	mutex_lock(&icc_lock);
 	mutex_lock(&icc_bw_lock);
+	v30_icc_sync_trace_active = v30_icc_trace;
 	synced_state = true;
 	list_for_each_entry(p, &icc_providers, provider_list) {
 		dev_dbg(p->dev, "interconnect provider is in synced state\n");
 		list_for_each_entry(n, &p->nodes, node_list) {
 			if (n->init_avg || n->init_peak) {
+				if (v30_icc_trace)
+					dev_notice(p->dev, "V30-R17 node begin %s init=%u/%u old=%u/%u\n",
+						   n->name, n->init_avg, n->init_peak, n->avg_bw, n->peak_bw);
 				n->init_avg = 0;
 				n->init_peak = 0;
 				aggregate_requests(n);
-				p->set(n, n);
+				if (v30_icc_trace)
+					dev_notice(p->dev, "V30-R17 node set %s avg=%u peak=%u\n", n->name, n->avg_bw, n->peak_bw);
+				ret = p->set(n, n);
+				if (v30_icc_trace)
+					dev_notice(p->dev, "V30-R17 node end %s ret=%d\n", n->name, ret);
 			}
 		}
 	}
+	v30_icc_sync_trace_active = false;
+	if (v30_icc_trace)
+		dev_notice(dev, "V30-R17 ICC final sync complete\n");
 	mutex_unlock(&icc_bw_lock);
 	mutex_unlock(&icc_lock);
 }
