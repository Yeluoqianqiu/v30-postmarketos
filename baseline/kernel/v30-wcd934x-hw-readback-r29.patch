 	case SND_SOC_DAPM_POST_PMU:
+		if (READ_ONCE(tx_hw_snapshot) && w->reg == WCD934X_ANA_AMIC1)
+			wcd934x_tx_hw_snapshot(comp, "adc-up-before-release");
 		if (READ_ONCE(amic_hold_release)) {
 			u16 hold_reg;
 			u8 hold_mask;
@@ -5192,6 +5235,8 @@
 			if (after & hold_mask)
 				return -EIO;
 		}
