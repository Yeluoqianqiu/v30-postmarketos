+/* These configuration registers have no read-to-clear status bits.
+ * regmap_read_bypassed() locks the map and restores both cache flags before
+ * returning. No global debugfs cache setting or new register write is used.
+ * Reads happen in the powered ADC callback, never from a later work item.
+ */
+static void wcd934x_tx_hw_snapshot(struct snd_soc_component *comp,
+				 const char *phase)
+{
+	static const u16 regs[] = {
+		WCD934X_ANA_AMIC1,
+		WCD934X_ANA_AMIC2,
+		WCD934X_ANA_MICB1,
+		WCD934X_CDC_TX6_TX_PATH_CTL,
+		WCD934X_CDC_TX6_TX_PATH_CFG0,
+		WCD934X_CDC_TX6_TX_PATH_CFG1,
+		WCD934X_CDC_TX6_TX_VOL_CTL,
+		WCD934X_CDC_TX0_TX_PATH_SEC2 + 16 * 6,
+		WCD934X_CDC_TX_INP_MUX_ADC_MUX6_CFG0,
+		WCD934X_CDC_IF_ROUTER_TX_MUX_CFG1,
+	};
+	struct wcd934x_codec *wcd = snd_soc_component_get_drvdata(comp);
+	unsigned int cached, hardware;
+	int cached_ret, hardware_ret;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		cached = hardware = 0;
+		cached_ret = regmap_read(wcd->regmap, regs[i], &cached);
+		hardware_ret = regmap_read_bypassed(wcd->regmap, regs[i],
+						   &hardware);
+		dev_info(comp->dev,
+			 "V30-TX-HW phase=%s reg=%#x cached_rc=%d cached=%#x hw_rc=%d hw=%#x\n",
+			 phase, regs[i], cached_ret, cached, hardware_ret, hardware);
+	}
+}
+
