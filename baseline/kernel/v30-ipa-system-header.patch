@@ -98,6 +100,16 @@ void ipa_cmd_table_init_add(struct gsi_trans *trans, enum ipa_cmd_opcode opcode,
 void ipa_cmd_hdr_init_local_add(struct gsi_trans *trans, u32 offset, u16 size,
