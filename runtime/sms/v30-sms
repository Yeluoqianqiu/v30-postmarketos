"""TTY SMS status, listing, reading and explicit sending; no automatic retries."""
from pathlib import Path
import argparse,json,os,sys
sys.path.insert(0,'/opt/v30-sms')
from sms_core import Store,send_once,terminal
from sms_bus import Bus
p=argparse.ArgumentParser(description='TTY SMS: status / list / read ID / send FULL_NUMBER --text TEXT')
s=p.add_subparsers(dest='action',required=True)
s.add_parser('status');l=s.add_parser('list');l.add_argument('--unread',action='store_true');l.add_argument('--limit',type=int,default=50,choices=range(1,201),metavar='1..200')
r=s.add_parser('read');r.add_argument('id',type=int)
r=s.add_parser('send');r.add_argument('number');g=r.add_mutually_exclusive_group(required=True);g.add_argument('--text');g.add_argument('--file',type=Path);r.add_argument('--request-id',help='Submit each request ID once; reusing it does not resend')
a=p.parse_args()
if os.geteuid()!=0:p.error('Run this command with sudo v30-sms')
os.umask(0o077)
def main():
    store=Store('/var/lib/v30-sms/messages.sqlite')
    try:
        if a.action=='status':
            state=Path('/run/v30-sms/status.json');print(json.dumps({'archive':store.counts(),'receiver':json.loads(state.read_text()) if state.exists() else {'ready':False}},ensure_ascii=False))
        elif a.action=='list':
            for row in store.listing(a.limit,a.unread):
                print(row['id'],('-' if row['direction']=='outgoing' else 'unread' if row['unread'] else 'read'),row['direction'],row['state'],terminal(row['timestamp']),terminal(row['number']))
        elif a.action=='read':
            row=store.get(a.id,mark_read=True);print('ID:',row['id'],'Direction:',row['direction'],'State:',row['state']);print('Number:',terminal(row['number']),'Timestamp:',terminal(row['timestamp']));print(terminal(row['text']))
            data=json.loads(row['data'])
            if data:print('[Binary SMS:',len(data),'bytes; stored in the private archive]')
        else:
            text=a.file.read_text(encoding='utf-8') if a.file else a.text
            row,fresh,info=send_once(store,Bus(),a.number,text,a.request_id)
            print(json.dumps({'id':row['id'],'request_id':row['request_id'],'state':row['state'],'new_submission':fresh,**info},ensure_ascii=False))
            if row['state'] in ('unknown','creating','created','sending'):
                print('The send result is unconfirmed and the record is retained; inspect its state and do not resend.',file=sys.stderr);return 2
            print('Queued; network submission is not yet confirmed.' if row['state']=='queued' else 'Submitted to the network; receipt requires recipient confirmation or a delivery report.')
        return 0
    finally:store.close()
try:raise SystemExit(main())
except Exception as exc:
    # Driver/D-Bus error text can carry private content. Keep it out of logs.
    print('SMS operation failed: '+(str(exc) if isinstance(exc,ValueError) else type(exc).__name__),file=sys.stderr);raise SystemExit(1)
