# SPDX-License-Identifier: GPL-3.0-only
"""Explicit call control, local call history and ringtone-volume settings."""
import argparse, datetime, json, os, re, subprocess, sys
sys.path.insert(0, '/opt/v30-mobile/libexec')
from gvariant_json import parse_gvariant

p = argparse.ArgumentParser(description='V30: status / calls / dial NUMBER / answer / hangup / history / ring-volume [0..100]')
p.add_argument('action', choices=['status','calls','dial','answer','hangup','history','ring-volume'])
p.add_argument('number', nargs='?')
p.add_argument('--missed', action='store_true', help='Show only confirmed missed calls')
p.add_argument('--mark-read', action='store_true', help='Clear notification marks only for the history rows shown')
p.add_argument('--limit', type=int, default=20, choices=range(1,101), metavar='1..100')
a = p.parse_args()
if os.geteuid() != 0: p.error('Run this command with sudo v30-phone')
os.umask(0o077)

def call(method, *args):
    out = subprocess.check_output(['gdbus','call','--system','--dest','net.catcrafts.IMS1',
        '--object-path','/net/catcrafts/IMS1','--method','net.catcrafts.IMS1.'+method,*args], text=True, timeout=10)
    return parse_gvariant(out)

if a.action == 'ring-volume':
    from alert_view import CONFIG, ring_volume
    from mobile_common import atomic_json
    if a.number is not None:
        if not re.fullmatch(r'[0-9]{1,3}',a.number) or int(a.number)>100:
            p.error('Ringtone volume must be 0..100; 0 mutes ringing')
        if CONFIG.is_symlink(): p.error('Refusing a symlinked ringtone configuration')
        atomic_json(CONFIG, {'ring_volume':int(a.number)})
        subprocess.run(['/usr/local/sbin/v30-console-metrics','--force'],
                       stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=5)
    value=ring_volume()
    print('Ringtone volume: '+str(value)+'%'+(' (muted)' if value==0 else ''))
elif a.action == 'history':
    from call_history import History
    store=History()
    try:
        rows=store.listing(a.limit,a.missed)
        if not rows: print('No matching call history.')
        for row in rows:
            stamp=datetime.datetime.fromtimestamp(row['started']).astimezone().isoformat(timespec='seconds')
            evidence=' [test-report]' if row['evidence']=='test-report' else ''
            print(row['id'],stamp,row['direction'],row['result'],row['number']+evidence)
        if a.mark_read:
            store.acknowledge([row['id'] for row in rows])
            subprocess.run(['/usr/local/sbin/v30-console-metrics','--force'],
                           stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=5)
    finally: store.close()
elif a.action == 'status': print(json.dumps(call('GetStatus')[0],ensure_ascii=False))
elif a.action == 'calls': print(json.dumps(call('GetCalls')[0],ensure_ascii=False))
elif a.action == 'dial':
    if not a.number or not re.fullmatch(r'\+?[0-9]{3,20}',a.number): p.error('Enter a full phone number')
    print(call('Dial',a.number)[0])
else:
    calls=call('GetCalls')[0]
    chosen=[c for c in calls if c['state']=='incoming'] if a.action=='answer' else [c for c in calls if c['state']!='terminated']
    if len(chosen)!=1: p.error('Exactly one eligible call is required; inspect calls first')
    call('Accept' if a.action=='answer' else 'HangUp',chosen[0]['uni'])
