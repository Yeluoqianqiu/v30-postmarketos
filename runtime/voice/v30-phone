"""TTY call control; each dial or answer operation requires an explicit command."""
import argparse, json, os, re, subprocess, sys
sys.path.insert(0, '/opt/v30-mobile/libexec')
from gvariant_json import parse_gvariant

p = argparse.ArgumentParser(description='V30 calls: status / calls / dial NUMBER / answer / hangup')
p.add_argument('action', choices=['status', 'calls', 'dial', 'answer', 'hangup'])
p.add_argument('number', nargs='?'); a = p.parse_args()
if os.geteuid() != 0: p.error('Run this command with sudo v30-phone')

def call(method, *args):
    out = subprocess.check_output(['gdbus', 'call', '--system', '--dest', 'net.catcrafts.IMS1',
        '--object-path', '/net/catcrafts/IMS1', '--method', 'net.catcrafts.IMS1.'+method, *args], text=True, timeout=10)
    return parse_gvariant(out)

if a.action == 'status': print(json.dumps(call('GetStatus')[0], ensure_ascii=False))
elif a.action == 'calls': print(json.dumps(call('GetCalls')[0], ensure_ascii=False))
elif a.action == 'dial':
    if not a.number or not re.fullmatch(r'\+?[0-9]{3,20}', a.number): p.error('Enter a full phone number')
    print(call('Dial', a.number)[0])
else:
    calls = call('GetCalls')[0]
    chosen = [c for c in calls if c['state'] == 'incoming'] if a.action == 'answer' else [c for c in calls if c['state'] != 'terminated']
    if len(chosen) != 1: p.error('Exactly one eligible call is required; inspect calls first')
    call('Accept' if a.action == 'answer' else 'HangUp', chosen[0]['uni'])
