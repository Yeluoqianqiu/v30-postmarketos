#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-only
"""Explicitly start/stop an isolated graphical session, keeping tty1 as default."""
import argparse,errno,fcntl,json,os,pwd,re,signal,subprocess,sys,time,struct
from pathlib import Path


def parse_args(argv=None):
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('action',choices=['start','stop','status','run'])
    p.add_argument('--output',choices=['auto','internal','external'],
                   help='Choose the output at session start (default: auto)')
    a=p.parse_args(argv)
    if a.output is not None and a.action not in {'start','run'}:
        p.error('--output is only available with start')
    a.output=a.output or 'auto'
    return a


def connected(connector):
    try:return (connector/'status').read_text().strip()=='connected'
    except FileNotFoundError:return False


def output_plan(requested,drm=Path('/sys/class/drm')):
    # This profile supports the V30's native DSI and wired DP connectors only.
    def find(name):
        matches=[entry for entry in drm.glob('card*-'+name)
                 if re.fullmatch(r'card[0-9]+-'+name,entry.name)]
        if len(matches)>1:raise RuntimeError('Ambiguous DRM connector: '+name)
        return matches[0] if matches else None
    internal,external=find('DSI-1'),find('DP-1')
    use_external=requested=='external' or (requested=='auto' and external is not None and connected(external))
    selected=external if use_external else internal
    if selected is None or not connected(selected):
        raise RuntimeError('No connected '+('DP-1 external' if use_external else 'DSI-1 internal')+' output')
    card,name=selected.name.split('-',1)
    names={entry.name[len(card)+1:] for entry in drm.glob(card+'-*')
           if (entry/'status').is_file() and re.fullmatch(r'[A-Za-z0-9-]+',entry.name[len(card)+1:])}
    names.update({'DSI-1','DP-1'})
    # Weston 16 falls back to EDID preferred when a shorthand mode is absent.
    # A full, fixed CEA modeline avoids accidentally selecting a 4K preference.
    modeline='148.500 1920 2008 2052 2200 1080 1084 1089 1125 +hsync +vsync'
    return {'output':'external' if use_external else 'internal','connector':name,
            'drm_device':card,'status_path':str(selected),'connectors':sorted(names),
            'mode':'1920x1080@60' if use_external else 'preferred',
            'weston_mode':modeline if use_external else 'preferred',
            'geometry':'1920x1080' if use_external else '1440x2880',
            'gtk_scale':1 if use_external else 2}


def write_output_configuration(root,plan,base=Path('/etc/v30-desktop/weston.ini')):
    # Root-owned files bridge greetd/PAM without relying on inherited environment.
    config=base.read_text().rstrip()+'\n'
    for name in plan['connectors']:
        mode=plan['weston_mode'] if name==plan['connector'] else 'off'
        config+='\n[output]\nname='+name+'\nmode='+mode+'\ntransform=normal\nscale=1\n'
    (root/'weston.ini').write_text(config)
    (root/'weston.ini').chmod(0o644)
    values={'V30_GUI_OUTPUT':plan['output'],'V30_GUI_CONNECTOR':plan['connector'],
            'V30_GUI_DRM_DEVICE':plan['drm_device'],'V30_GUI_GEOMETRY':plan['geometry'],
            'GDK_SCALE':plan['gtk_scale']}
    (root/'session.env').write_text(''.join('export '+key+'='+str(value)+'\n' for key,value in values.items()))
    (root/'session.env').chmod(0o644)


def check_external_touch_mapping(inputs=Path('/sys/class/input')):
    # Installing a rule alone does not update already enumerated input devices.
    # Refuse external GUI until the live udev property confines stmfts to DSI.
    for event in inputs.glob('event*'):
        try:name=(event/'device/name').read_text().strip()
        except FileNotFoundError:continue
        if name!='stmfts':continue
        properties=subprocess.check_output(['udevadm','info','--query=property',
                                            '--path='+str(event)],text=True,timeout=5)
        if 'WL_OUTPUT=DSI-1' not in properties.splitlines():
            raise RuntimeError('Refresh the stmfts udev rule before external GUI; WL_OUTPUT must be DSI-1')


def main(argv=None):
    a=parse_args(argv)
    run(a)


def run(a):
    if os.geteuid()!=0:raise SystemExit('Use sudo v30-gui start|stop|status')
    os.umask(0o077)
    root=Path('/run/v30-desktop');root.mkdir(mode=0o755,exist_ok=True)
    root.chmod(0o755)
    state=root/'state.json'
    if a.action=='status':
        print(state.read_text() if state.exists() else '{"active": false}')
        raise SystemExit(0)
    if a.action=='stop':
        if state.exists():
            data=json.loads(state.read_text())
            if data['active']:
                pid=data['pid'];proc=Path(f'/proc/{pid}/stat')
                if proc.exists() and proc.read_text().rsplit(')',1)[1].split()[19]==data['start_ticks']:
                    os.kill(pid,signal.SIGTERM)
        raise SystemExit(0)
    if a.action=='start':
        if state.exists() and json.loads(state.read_text()).get('active'):
            raise SystemExit('GUI already active; use status or stop')
        with (root/'controller.log').open('a') as controller_log:
            subprocess.Popen([sys.executable,__file__,'run','--output',a.output],start_new_session=True,
                             stdin=subprocess.DEVNULL,stdout=controller_log,stderr=controller_log)
        print('Starting the optional GUI on tty8; use sudo v30-gui stop to return to tty1')
        raise SystemExit(0)
    with (root/'control.lock').open('a') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        if Path('/sys/class/tty/tty0/active').read_text().strip()!='tty1':raise SystemExit('Start from the landscape TTY baseline')
        if json.loads(subprocess.check_output(['/usr/local/sbin/v30-phone','calls'],text=True)):
            raise SystemExit('Wait until the current call has ended')
        plan=output_plan(a.output)
        if plan['output']=='external':check_external_touch_mapping()
        write_output_configuration(root,plan)
        account=pwd.getpwnam('v30')
        user=root/'user';user.mkdir(mode=0o700,exist_ok=True);os.chown(user,account.pw_uid,account.pw_gid)
        # The end marker is written by the unprivileged fallback session, not a greeter.
        end=user/'session-ended';end.unlink(missing_ok=True)
        (root/'greetd-run').unlink(missing_ok=True)
        data={'active':True,'backend':'weston-pixman-rootful','pid':os.getpid(),'start_ticks':Path('/proc/self/stat').read_text().rsplit(')',1)[1].split()[19]}
        data.update({key:plan[key] for key in ('output','connector','drm_device','mode','geometry','gtk_scale')})
        data['output_requested']=a.output
        state.write_text(json.dumps(data)+'\n')
        stopping=False
        def stop(signum,frame):
            nonlocal stopping
            stopping=True
        signal.signal(signal.SIGTERM,stop)
        signal.signal(signal.SIGINT,stop)
        log=(root/'session.log').open('a')
        # This manually started broker replaces unavailable logind seat ownership.
        # It is not enabled as a boot service and never replaces an existing broker.
        socket=Path('/run/seatd.sock')
        if socket.exists():
            data['active']=False;state.write_text(json.dumps(data)+'\n');log.close()
            raise SystemExit('An existing seatd socket needs inspection before starting another broker')
        seat=subprocess.Popen(['seatd','-g','video','-l','info'],stdout=log,stderr=log,start_new_session=True)
        data['seat_pid']=seat.pid;state.write_text(json.dumps(data)+'\n')
        process=None
        try:
            deadline=time.monotonic()+5
            while not socket.exists() and seat.poll() is None and time.monotonic()<deadline and not stopping:time.sleep(.05)
            if not socket.exists() or seat.poll() is not None or stopping:raise RuntimeError('Manual seat broker did not become ready')
            process=subprocess.Popen(['greetd','--config','/etc/v30-desktop/greetd.toml'],stdout=log,stderr=log,start_new_session=True)
            while process.poll() is None and seat.poll() is None and not stopping and not end.exists():
                if plan['output']=='external' and not connected(Path(plan['status_path'])):
                    data['stop_reason']='external-disconnected'
                    break
                time.sleep(.25)
        finally:
            if process is not None and process.poll() is None:
                process.terminate()
                try:process.wait(timeout=10)
                except subprocess.TimeoutExpired:os.killpg(process.pid,signal.SIGKILL);process.wait()
            if seat.poll() is None:
                seat.terminate()
                try:seat.wait(timeout=3)
                except subprocess.TimeoutExpired:seat.kill();seat.wait()
            # Earlier manual sessions left D-Bus/IME helpers after the display closed.
            # Only terminate known GUI helpers from this private runtime and user.
            helpers={'dbus-daemon','feedbackd','dconf-service','uim-helper-serv',
                     'uim-candwin-gtk','at-spi-bus-laun','at-spi2-registr'}
            for proc in Path('/proc').glob('[0-9]*'):
                try:
                    if proc.stat().st_uid!=account.pw_uid or (proc/'comm').read_text().strip() not in helpers:continue
                    if b'XDG_RUNTIME_DIR=/run/v30-desktop/user' in (proc/'environ').read_bytes().split(b'\0'):
                        os.kill(int(proc.name),signal.SIGTERM)
                except (FileNotFoundError,ProcessLookupError):pass
            # greetd can leave VT_PROCESS/KD_GRAPHICS after its worker exits.
            # Reset the manually owned tty8 before activating tty1; chvt can wait forever.
            # PAM/elogind can revoke tty8 while greetd finishes closing its session.
            # Reopen on EIO rather than retrying an already revoked descriptor.
            for command,arg in [(0x5602,struct.pack('BBhhh',0,0,0,0,0)),
                                (0x4b3a,0),(0x560c,0),(0x5606,1)]:
                deadline=time.monotonic()+5
                while True:
                    fd=os.open('/dev/tty0',os.O_RDWR|os.O_NOCTTY)
                    try:
                        fcntl.ioctl(fd,command,arg)
                        break
                    except OSError as error:
                        if error.errno!=errno.EIO or time.monotonic()>=deadline:raise
                        time.sleep(.25)
                    finally:os.close(fd)
            subprocess.run(['/usr/local/sbin/v30-display','on'],check=False,timeout=10)
            subprocess.run(['/usr/local/sbin/v30-console-metrics','--force'],stdout=subprocess.DEVNULL,check=False,timeout=10)
            data['active']=False;data['exit_status']=process.returncode if process is not None else 125;state.write_text(json.dumps(data)+'\n')
            log.close()


if __name__=='__main__':main()
