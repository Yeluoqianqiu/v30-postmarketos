#!/bin/sh
# Run as root by tty1 getty; the tmux pane starts the normal authenticated login path.
set -eu
umask 077
mkdir -p /run/v30-console
chmod 700 /run/v30-console
export TERM=linux
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
/usr/local/sbin/v30-console-font > /run/v30-console/font-result.json
exec /usr/bin/tmux -u -S /run/v30-console/tmux.sock -f /etc/v30-console.conf new-session -s local -n console 'exec /sbin/getty -i -L 38400 - screen'
