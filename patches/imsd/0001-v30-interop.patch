+// Engine-thread-only, bounded metadata. Never print a request URI, header
+// value, SDP, identity, authentication material, or media payload here.
+void TraceSip(std::string_view event, std::string_view msg, long sent = -2, int error = 0) {
+    static const bool enabled = EnvOr("TRACE_CALL_SIP", "0") == "1";
+    static unsigned count = 0;
+    if (!enabled || count >= 512) return;
+    auto cs = imsd::sip::Header(msg, "CSeq").value_or("");
+    auto space = cs.find(' ');
+    auto method = space == std::string_view::npos ? std::string_view{} : cs.substr(space + 1);
+    bool callMethod = false;
+    for (auto known : {"INVITE", "ACK", "PRACK", "UPDATE", "CANCEL", "BYE"})
+        if (method == known) callMethod = true;
+    if (!callMethod) return;
+    unsigned seq = 0;
+    auto number = cs.substr(0, space);
+    auto parsed = std::from_chars(number.data(), number.data() + number.size(), seq);
+    if (parsed.ec != std::errc{} || parsed.ptr != number.data() + number.size()) seq = 0;
+    const auto boundary = msg.find("\r\n\r\n");
+    const auto body = boundary == std::string_view::npos ? std::string_view{} : msg.substr(boundary + 4);
+    auto contentType = imsd::sip::Header(msg, "Content-Type").value_or("");
+    std::string normalized(contentType.substr(0, contentType.find(';')));
+    while (!normalized.empty() && normalized.back() == ' ') normalized.pop_back();
+    for (char& ch : normalized) ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+    const std::string_view type = contentType.empty() ? "none" : normalized == "application/sdp" ? "sdp" : "other";
+    ++count;
+    Log(std::format("call-sip event={} method={} cseq={} status={} via={} bytes={} sent={} errno={} ct={} body={} audio={}",
+                    event, method, seq, imsd::sip::Status(msg).value_or(0),
+                    imsd::sip::Headers(msg, "Via").size(), msg.size(), sent, error, type, body.size(), body.contains("m=audio") ? 1 : 0));
+    if (count == 512) Log("call-sip limit reached");
+}
