From 0945b59544d58f774839bde1b1ec9fff7ea204b4 Mon Sep 17 00:00:00 2001
From: Dmitry Baryshkov <dmitry.baryshkov@oss.qualcomm.com>
Date: Mon, 19 Oct 2026 16:41:01 +0300
Subject: [PATCH 5/5] clk: qcom: gcc-msm8998: leave the MMSS QM clocks on

Adapt Dmitry Baryshkov's published October 19 fix to the joan working
branch, preserving its existing clock hardware array and other changes.
Stop registering the MMSS QM branches and enable their CBCRs at probe
through qcom_cc_driver_data, as in the original patch. Preserve existing
DT IDs and consumer handling. The combined CBCR list is address-sorted.

Original author and Signed-off-by are preserved from the published patch.
Link: https://lore.kernel.org/all/20261019-msm8998-fix-clocks-v1-2-370949e4d8a0@oss.qualcomm.com/
Test: gcc-msm8998.o on native Alpine aarch64 against dc9c6692dbfb;
strict checkpatch, sequential patch application and git diff --check.
No boot of this rebased kernel was attempted.

Signed-off-by: Dmitry Baryshkov <dmitry.baryshkov@oss.qualcomm.com>

Signed-off-by: ygc <yeqianqiu1995@gmail.com>
Assisted-by: Codex:OpenAI/GPT-6
---
 drivers/clk/qcom/gcc-msm8998.c | 35 ++++++----------------------------
 1 file changed, 6 insertions(+), 29 deletions(-)

diff --git a/drivers/clk/qcom/gcc-msm8998.c b/drivers/clk/qcom/gcc-msm8998.c
index c5a1397..ca2b1c5 100644
--- a/drivers/clk/qcom/gcc-msm8998.c
+++ b/drivers/clk/qcom/gcc-msm8998.c
@@ -2273,32 +2273,6 @@ static struct clk_branch gcc_mmss_noc_cfg_ahb_clk = {
 	},
 };
 
-static struct clk_branch gcc_mmss_qm_ahb_clk = {
-	.halt_reg = 0x9030,
-	.halt_check = BRANCH_HALT,
-	.clkr = {
-		.enable_reg = 0x9030,
-		.enable_mask = BIT(0),
-		.hw.init = &(struct clk_init_data){
-			.name = "gcc_mmss_qm_ahb_clk",
-			.ops = &clk_branch2_ops,
-		},
-	},
-};
-
-static struct clk_branch gcc_mmss_qm_core_clk = {
-	.halt_reg = 0x900c,
-	.halt_check = BRANCH_HALT,
-	.clkr = {
-		.enable_reg = 0x900c,
-		.enable_mask = BIT(0),
-		.hw.init = &(struct clk_init_data){
-			.name = "gcc_mmss_qm_core_clk",
-			.ops = &clk_branch2_ops,
-		},
-	},
-};
-
 static struct clk_branch gcc_mmss_sys_noc_axi_clk = {
 	.halt_reg = 0x9000,
 	.halt_check = BRANCH_HALT,
@@ -3092,8 +3066,6 @@ static struct clk_regmap *gcc_msm8998_clocks[] = {
 	[GCC_HMSS_RBCPR_CLK] = &gcc_hmss_rbcpr_clk.clkr,
 	[GCC_HMSS_TRIG_CLK] = &gcc_hmss_trig_clk.clkr,
 	[GCC_MMSS_NOC_CFG_AHB_CLK] = &gcc_mmss_noc_cfg_ahb_clk.clkr,
-	[GCC_MMSS_QM_AHB_CLK] = &gcc_mmss_qm_ahb_clk.clkr,
-	[GCC_MMSS_QM_CORE_CLK] = &gcc_mmss_qm_core_clk.clkr,
 	[GCC_MMSS_SYS_NOC_AXI_CLK] = &gcc_mmss_sys_noc_axi_clk.clkr,
 	[GCC_MSS_AT_CLK] = &gcc_mss_at_clk.clkr,
 	[GCC_PCIE_0_AUX_CLK] = &gcc_pcie_0_aux_clk.clkr,
@@ -3323,7 +3295,12 @@ static struct clk_hw *gcc_msm8998_hws[] = {
 	&gpll0_out_main_div2.hw,
 };
 
+/* Keep firmware-owned graphics/interconnect branches enabled at probe;
+ * do not let later CCF registration or unused-clock cleanup gate them.
+ */
 static const u32 gcc_msm8998_critical_cbcrs[] = {
+	0x900c, /* GCC_MMSS_QM_CORE_CLK */
+	0x9030, /* GCC_MMSS_QM_AHB_CLK */
 	0x7100c, /* GCC_GPU_BIMC_GFX_SRC_CLK */
 	0x71018, /* GCC_GPU_SNOC_DVM_GFX_CLK */
 };
@@ -3341,9 +3318,9 @@ static const struct qcom_cc_desc gcc_msm8998_desc = {
 	.num_resets = ARRAY_SIZE(gcc_msm8998_resets),
 	.gdscs = gcc_msm8998_gdscs,
 	.num_gdscs = ARRAY_SIZE(gcc_msm8998_gdscs),
-	.driver_data = &gcc_msm8998_driver_data,
 	.clk_hws = gcc_msm8998_hws,
 	.num_clk_hws = ARRAY_SIZE(gcc_msm8998_hws),
+	.driver_data = &gcc_msm8998_driver_data,
 };
 
 static int gcc_msm8998_probe(struct platform_device *pdev)
-- 
