From e51bc3f0be6a13344d98a09c1545b198a4371b58 Mon Sep 17 00:00:00 2001
From: ygc <yeqianqiu1995@gmail.com>
Date: Sat, 31 Oct 2026 07:47:00 +0800
Subject: [PATCH 1/5] power: supply: pmi8998_fg: fix charger status and
 fallback current sign

The charger may already be present before its first change notification.
Query its status directly and use the current fallback only when it is not
available. get_current() already normalizes charging current to positive,
so the previous comparison reported the opposite state. Keep UNKNOWN when
the notifier property read fails instead of reading an undefined propval.

Test: pmi8998_fg.o on native Alpine aarch64 against dc9c6692dbfb;
strict checkpatch and git diff --check. The rebased kernel was not booted.

Signed-off-by: ygc <yeqianqiu1995@gmail.com>
Assisted-by: Codex:OpenAI/GPT-6
---
 drivers/power/supply/pmi8998_fg.c | 58 +++++++++++++++----------------
 1 file changed, 28 insertions(+), 30 deletions(-)

diff --git a/drivers/power/supply/pmi8998_fg.c b/drivers/power/supply/pmi8998_fg.c
index d39b25d..f6f7bda 100644
--- a/drivers/power/supply/pmi8998_fg.c
+++ b/drivers/power/supply/pmi8998_fg.c
@@ -321,38 +321,36 @@ static int pmi8998_fg_get_property(struct power_supply *psy,
 
 	switch (psp) {
 	case POWER_SUPPLY_PROP_STATUS:
-		/* Get status from charger if available */
-		if (chip->chg_psy &&
-		    chip->status != POWER_SUPPLY_STATUS_UNKNOWN) {
-			val->intval = chip->status;
-		} else {
-			/*
-			 * Fall back to capacity and current-based
-			 * status checking
-			 */
-			ret = pmi8998_fg_get_capacity(chip, &temp);
-			if (ret) {
-				val->intval = POWER_SUPPLY_STATUS_UNKNOWN;
-				break;
-			}
-			if (temp == 100) {
-				val->intval = POWER_SUPPLY_STATUS_FULL;
+		/* Query the charger even before its first change notification. */
+		if (chip->chg_psy) {
+			ret = power_supply_get_property(chip->chg_psy,
+							POWER_SUPPLY_PROP_STATUS, val);
+			if (!ret && val->intval != POWER_SUPPLY_STATUS_UNKNOWN)
 				break;
-			}
+		}
 
-			ret = pmi8998_fg_get_current(chip, &temp);
-			if (ret) {
-				val->intval = POWER_SUPPLY_STATUS_UNKNOWN;
-				break;
-			}
-			if (temp < 0)
-				val->intval = POWER_SUPPLY_STATUS_CHARGING;
-			else if (temp > 0)
-				val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
-			else
-				val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		ret = pmi8998_fg_get_capacity(chip, &temp);
+		if (ret) {
+			val->intval = POWER_SUPPLY_STATUS_UNKNOWN;
+			break;
+		}
+		if (temp == 100) {
+			val->intval = POWER_SUPPLY_STATUS_FULL;
+			break;
 		}
 
+		ret = pmi8998_fg_get_current(chip, &temp);
+		if (ret) {
+			val->intval = POWER_SUPPLY_STATUS_UNKNOWN;
+			break;
+		}
+		/* get_current() already converts to positive charging current. */
+		if (temp > 0)
+			val->intval = POWER_SUPPLY_STATUS_CHARGING;
+		else if (temp < 0)
+			val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+		else
+			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
 		break;
 	case POWER_SUPPLY_PROP_TECHNOLOGY:
 		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
@@ -534,8 +532,8 @@ static int pmi8998_fg_notifier_call(struct notifier_block *nb, unsigned long val
 						POWER_SUPPLY_PROP_STATUS, &propval);
 		if (ret)
 			chip->status = POWER_SUPPLY_STATUS_UNKNOWN;
-
-		chip->status = propval.intval;
+		else
+			chip->status = propval.intval;
 
 		power_supply_changed(chip->batt_psy);
 
